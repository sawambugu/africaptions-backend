// Africaptions CMS data model.
// Client = a paying customer account. Tier controls CMS entitlement:
//   FREE/STANDARD  -> can request work via the contact form only.
//   ADVANCED       -> unlocks self-service CMS access (projects, media, captions).
// Staff users (role ADMIN) always have full CMS access regardless of tier.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Tier {
  FREE
  STANDARD
  ADVANCED
}

enum Role {
  ADMIN
  CLIENT
}

enum ProjectStatus {
  DRAFT
  IN_PROGRESS
  REVIEW
  DELIVERED
  ARCHIVED
}

enum PaymentProvider {
  PAYSTACK
  MPESA
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum CaptionFormat {
  SRT
  VTT
  SCC
  TXT
}

model Client {
  id        String    @id @default(cuid())
  name      String
  tier      Tier      @default(FREE)
  // When the current paid tier lapses. NULL means "does not expire"
  // (e.g. an admin manually granted the tier with no end date).
  // Set automatically on successful payment; checked (and lazily enforced)
  // by middleware/requireTier.js on every CMS request.
  tierExpiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  users          User[]
  projects       Project[]
  paymentIntents PaymentIntent[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(CLIENT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  client   Client? @relation(fields: [clientId], references: [id])
  clientId String?
}

model Project {
  id        String        @id @default(cuid())
  title     String
  status    ProjectStatus @default(DRAFT)
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  client   Client @relation(fields: [clientId], references: [id])
  clientId String

  media          MediaAsset[]
  captionTracks  CaptionTrack[]
}

model MediaAsset {
  id         String   @id @default(cuid())
  filename   String
  url        String
  mimeType   String
  sizeBytes  Int
  createdAt  DateTime @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
}

model CaptionTrack {
  id         String        @id @default(cuid())
  language   String
  format     CaptionFormat
  fileUrl    String
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
}

// Tracks a single payment attempt through to completion, for both
// providers. Necessary because M-Pesa's STK Push callback carries back
// only the CheckoutRequestID we gave it (no arbitrary metadata), so we
// need our own record to reconcile "which client, which plan" once the
// callback/webhook arrives. Also gives an audit trail and makes webhook
// handling idempotent (a provider retry just finds the same row).
model PaymentIntent {
  id        String          @id @default(cuid())
  provider  PaymentProvider
  reference String          @unique // Paystack transaction reference, or M-Pesa CheckoutRequestID
  planDays  Int
  amount    Int // in the provider's whole currency unit (KES)
  status    PaymentStatus   @default(PENDING)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  client   Client @relation(fields: [clientId], references: [id])
  clientId String
}

// Marketing site content (pages/posts), managed by staff only.
model Page {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  body        String
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
