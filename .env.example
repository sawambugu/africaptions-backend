# Copy this file to .env and fill in real values. Never commit .env.

# --- Server ---
PORT=4000
NODE_ENV=development
# Public URL of this backend (used in Paystack/M-Pesa redirect URLs and
# local file URLs). Must be a real HTTPS URL Safaricom/Paystack can reach
# for webhooks/callbacks to work outside local dev.
APP_URL=http://localhost:4000

# --- Database (PostgreSQL) ---
# Local dev with docker-compose: postgresql://africaptions:africaptions@localhost:5432/africaptions
DATABASE_URL=postgresql://user:password@localhost:5432/africaptions

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# --- Advanced (Tier 2) plan pricing ---
# Neither Paystack mobile money nor M-Pesa STK Push supports true recurring
# billing, so a payment buys a fixed number of days of CMS access.
ADVANCED_PLAN_DAYS=30
ADVANCED_PLAN_PRICE_KES=2000

# --- Paystack (card / mobile money checkout) ---
PAYSTACK_SECRET_KEY=sk_test_...

# --- M-Pesa (Safaricom Daraja API — STK Push) ---
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=...
MPESA_CONSUMER_SECRET=...
# Daraja sandbox shortcode/passkey are published in the Safaricom developer
# portal; use your own Paybill/Till + passkey in production.
MPESA_SHORTCODE=174379
MPESA_PASSKEY=...
# Shared secret appended to the callback URL as ?key=... since Daraja does
# not sign callbacks the way Stripe/Paystack sign webhooks.
MPESA_CALLBACK_SECRET=replace-with-a-long-random-secret

# --- File storage (media/caption uploads) ---
# "local" for development only (files are lost on redeploy). Use "s3" in
# production with an S3-compatible bucket (AWS S3, Cloudflare R2, Backblaze B2, DO Spaces).
STORAGE_DRIVER=local
# UPLOAD_DIR=./uploads

# S3_BUCKET=africaptions-media
# S3_REGION=auto
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL_BASE=https://cdn.example.com

# --- Contact form email (existing feature) ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# CONTACT_TO=hello@africaptions.example
