# Copy this file to .env and fill in real values. Never commit .env.

# --- Server ---
PORT=4000
NODE_ENV=development
# Public URL of this backend (used in Stripe redirect URLs and local file URLs).
APP_URL=http://localhost:4000

# --- Database (PostgreSQL) ---
# Local dev with docker-compose: postgresql://africaptions:africaptions@localhost:5432/africaptions
DATABASE_URL=postgresql://user:password@localhost:5432/africaptions

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# --- Stripe (billing / Tier 2 "Advanced" plan upgrade) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Price ID for the recurring "Advanced" plan, created in the Stripe Dashboard.
STRIPE_PRICE_ADVANCED=price_...

# --- File storage (media/caption uploads) ---
# "local" for development only (files are lost on redeploy). Use "s3" in
# production with an S3-compatible bucket (AWS S3, Cloudflare R2, Backblaze B2, DO Spaces).
STORAGE_DRIVER=local
# UPLOAD_DIR=./uploads

# S3_BUCKET=africaptions-media
# S3_REGION=auto
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL_BASE=https://cdn.example.com

# --- Contact form email (existing feature) ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# CONTACT_TO=hello@africaptions.example
